{
  "rules": [
    {
      "name": "Xilinx BUFG",
      "category": "clock primitive",
      "source_profile": "xilinx",
      "target_profile": "generic",
      "detect_regex": "\\\\bBUFG\\\\b",
      "replace_regex": "BUFG\\\\s+([A-Za-z_][A-Za-z0-9_]*)\\\\s*\\\\(\\\\s*\\\\.I\\\\(([^)]+)\\\\)\\\\s*,\\\\s*\\\\.O\\\\(([^)]+)\\\\)\\\\s*\\\\)\\\\s*;",
      "replacement": "assign \\\\3 = \\\\2; // mapped from Xilinx BUFG"
    },
    {
      "name": "Xilinx IBUF",
      "category": "io primitive",
      "source_profile": "xilinx",
      "target_profile": "generic",
      "detect_regex": "\\\\bIBUF\\\\b",
      "replace_regex": "IBUF\\\\s+([A-Za-z_][A-Za-z0-9_]*)\\\\s*\\\\(\\\\s*\\\\.I\\\\(([^)]+)\\\\)\\\\s*,\\\\s*\\\\.O\\\\(([^)]+)\\\\)\\\\s*\\\\)\\\\s*;",
      "replacement": "assign \\\\3 = \\\\2; // mapped from Xilinx IBUF"
    },
    {
      "name": "Intel global",
      "category": "clock primitive",
      "source_profile": "intel",
      "target_profile": "generic",
      "detect_regex": "\\\\bglobal\\\\b",
      "replace_regex": "global\\\\s+([A-Za-z_][A-Za-z0-9_]*)\\\\s*\\\\(\\\\s*\\\\.in\\\\(([^)]+)\\\\)\\\\s*,\\\\s*\\\\.out\\\\(([^)]+)\\\\)\\\\s*\\\\)\\\\s*;",
      "replacement": "assign \\\\3 = \\\\2; // mapped from Intel global clock primitive"
    },
    {
      "name": "ASIC CLKBUF",
      "category": "clock cell",
      "source_profile": "asic_generic",
      "target_profile": "generic",
      "detect_regex": "\\\\bCLKBUF_X1\\\\b",
      "replace_regex": "CLKBUF_X1\\\\s+([A-Za-z_][A-Za-z0-9_]*)\\\\s*\\\\(\\\\s*\\\\.A\\\\(([^)]+)\\\\)\\\\s*,\\\\s*\\\\.Y\\\\(([^)]+)\\\\)\\\\s*\\\\)\\\\s*;",
      "replacement": "assign \\\\3 = \\\\2; // abstracted from ASIC CLKBUF_X1"
    },
    {
      "name": "Generic clock buffer",
      "category": "clock abstraction",
      "source_profile": "generic",
      "target_profile": "xilinx",
      "detect_regex": "PORTABLE_CLKBUF",
      "replace_regex": "PORTABLE_CLKBUF\\\\s+([A-Za-z_][A-Za-z0-9_]*)\\\\s*\\\\(\\\\s*\\\\.I\\\\(([^)]+)\\\\)\\\\s*,\\\\s*\\\\.O\\\\(([^)]+)\\\\)\\\\s*\\\\)\\\\s*;",
      "replacement": "BUFG \\\\1 (.I(\\\\2), .O(\\\\3)); // Xilinx mapping"
    },
    {
      "name": "Generic clock buffer",
      "category": "clock abstraction",
      "source_profile": "generic",
      "target_profile": "intel",
      "detect_regex": "PORTABLE_CLKBUF",
      "replace_regex": "PORTABLE_CLKBUF\\\\s+([A-Za-z_][A-Za-z0-9_]*)\\\\s*\\\\(\\\\s*\\\\.I\\\\(([^)]+)\\\\)\\\\s*,\\\\s*\\\\.O\\\\(([^)]+)\\\\)\\\\s*\\\\)\\\\s*;",
      "replacement": "global \\\\1 (.in(\\\\2), .out(\\\\3)); // Intel mapping"
    }
  ]
}
